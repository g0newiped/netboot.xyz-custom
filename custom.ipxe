kernel https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/images/pxeboot/vmlinuz inst.ks=https://raw.githubusercontent.com/g0newiped/netboot.xyz-custom/master/kickstarts/budgie-atomic.ks
